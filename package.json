{
  "name": "badminton-court-manager",
  "private": true,
  "version": "0.0.0",
  "description": "📸 Snap, 🎲 Shuffle, 🏸 Play! The badminton organizer app that turns chaos into fair, fun matches. Upload your player list photo or add them manually to get perfectly balanced teams in seconds.",
  "type": "module",
  "homepage": "https://sylhare.github.io/Badminton",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "copy-tesseract-assets": "pnpm dlx tsx script/copy-tesseract-assets.ts",
    "dev": "vite",
    "build": "tsc && vite build && cp ./dist/index.html ./dist/404.html",
    "typecheck": "tsc --noEmit && tsc -p analysis/tsconfig.json",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 10",
    "lint:fix": "eslint . --report-unused-disable-directives --max-warnings 10 --fix",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "remove-comments": "pnpm dlx tsx script/remove_comments.ts src tests e2e"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@techstark/opencv-js": "5.0.0-release.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@playwright/test": "1.64.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^30.1.3",
    "playwright": "1.64.1",
    "tesseract.js-core": "^7.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
